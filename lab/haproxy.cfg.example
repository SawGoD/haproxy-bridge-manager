global
    log stdout format raw local0
    stats socket /tmp/bridge-lab.sock mode 600 level user
    stats socket ipv4@0.0.0.0:19490 level user

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 2s
    timeout client 30s
    timeout server 30s

frontend de1_in
    bind 0.0.0.0:10443
    default_backend de1_out

backend de1_out
    server de1_public 172.30.214.10:80 check inter 1s fall 2 rise 2
    server de1_netbird 172.30.214.11:80 backup check inter 1s fall 2 rise 2

frontend usa1_in
    bind 0.0.0.0:10444
    default_backend usa1_out

backend usa1_out
    server usa1_public 172.30.214.10:80 check inter 1s fall 2 rise 2
    server usa1_netbird 172.30.214.11:80 backup check inter 1s fall 2 rise 2

frontend lv1_in
    bind 0.0.0.0:10445
    default_backend lv1_out

backend lv1_out
    server lv1_public 172.30.214.10:80 check inter 1s fall 2 rise 2
    server lv1_netbird 172.30.214.11:80 backup check inter 1s fall 2 rise 2

frontend se1_in
    bind 0.0.0.0:10446
    default_backend se1_out

backend se1_out
    server se1_public4 172.30.214.10:80 check inter 1s fall 2 rise 2
    server se1_netbird 172.30.214.11:80 backup check inter 1s fall 2 rise 2
